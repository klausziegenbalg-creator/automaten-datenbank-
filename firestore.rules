rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function pinSessionDoc() {
      return get(/databases/$(database)/documents/pinSessions/$(uid()));
    }

    function hasValidPinSession() {
      return signedIn()
        && exists(/databases/$(database)/documents/pinSessions/$(uid()))
        && pinSessionDoc().data.expiresAt > request.time;
    }

    function isTeamleiter() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == "Teamleiter";
    }

    function teamleiterStadt() {
      return get(/databases/$(database)/documents/users/$(uid())).data.stadt;
    }

    // ---------------- Public READ (für Reiniger-Auswahl) ----------------
    match /automaten/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Wartungselemente/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------- PIN Sessions ----------------
    // Clients dürfen Sessions NICHT selbst schreiben (nur Function/Admin).
    match /pinSessions/{sessionId} {
      allow read: if signedIn() && sessionId == uid();
      allow create, update, delete: if false;
    }

    // ---------------- Reiniger Writes (nur mit Session) ----------------
    match /reinigungen/{docId} {
      allow create: if hasValidPinSession();
      // Reiniger sollen nicht "alles editieren" -> optional: update/delete aus
      allow update, delete: if false;

      // Lesen: Teamleiter darf eigene Stadt sehen (und Reiniger muss nicht lesen)
      allow read: if isTeamleiter() && resource.data.stadt == teamleiterStadt();
    }

    match /bestellungen/{docId} {
      // Reiniger braucht read (Buttons "bestellt") + write (bestellt/storniert)
      allow read: if hasValidPinSession()
        || (isTeamleiter() && resource.data.stadt == teamleiterStadt());

      allow create: if hasValidPinSession();
      allow update, delete: if false;
    }

    match /wochenWartung/{docId} {
      // Reiniger liest/legt an/updated (Tasks speichern)
      allow read: if hasValidPinSession()
        || (isTeamleiter() && resource.data.stadt == teamleiterStadt());

      allow create, update: if hasValidPinSession();
      allow delete: if false;
    }

    match /Wartungsprotokolle/{docId} {
      // Reiniger schreibt Einzelwartung
      allow create: if hasValidPinSession();
      allow update, delete: if false;

      // Teamleiter liest eigene Stadt (wenn Feld "stadt" existiert), sonst offen lassen:
      // Da deine Wartungsprotokolle payload aktuell kein "stadt" setzt,
      // erlauben wir Teamleiter-read ohne Stadtfilter nur für diese Collection NICHT,
      // sondern: entweder du ergänzt "stadt" im HTML (wäre UI-Logik), oder wir lassen read zu.
      // Hier: Teamleiter darf lesen, aber nur wenn stadt vorhanden und passt; sonst kein read.
      allow read: if isTeamleiter()
        && (
          (resource.data.stadt is string && resource.data.stadt == teamleiterStadt())
          || !(resource.data.stadt is string) // falls alt ohne stadt -> trotzdem lesbar für Teamleiter
        );
    }

    // ---------------- Users (Dashboard) ----------------
    match /users/{userId} {
      allow read: if signedIn() && userId == uid(); // jeder sieht nur sich
      allow write: if false;
    }

    // ---------------- Default deny ----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
