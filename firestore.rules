rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Basis-Helfer
    ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myUser() {
      return (signedIn() && exists(myUserPath()))
        ? get(myUserPath()).data
        : null;
    }

    function myRole() {
      return myUser() != null ? myUser().role : null;
    }

    function myCity() {
      return myUser() != null ? myUser().stadt : null;
    }

    function isPrivileged() {
      return signedIn() && (myRole() in ['Admin', 'Supervisor', 'Owner']);
    }

    function isTeamleiter() {
      return signedIn() && myRole() == 'Teamleiter';
    }

    function hasPinSession() {
      return signedIn() && request.auth.token.pin_ok == true;
    }

    // Teamleiter darf nur Dokumente seiner Stadt lesen (Doc-get)
    function teamleiterCityRead() {
      return isTeamleiter()
        && myCity() != null
        && resource.data.stadt == myCity();
    }

    // Teamleiter darf Queries lesen, WENN die Query auf seine Stadt einschränkt
    function teamleiterQueryRead() {
      return isTeamleiter()
        && myCity() != null
        && request.query != null
        && request.query.where('stadt', '==', myCity());
    }

    /* =========================
       Users
    ========================= */

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if isPrivileged();
    }

    /* =========================
       PINs (nur Admin / Server)
    ========================= */

    match /pins/{id} {
      allow read, write: if isPrivileged();
    }

    /* =========================
       Stammdaten (lesen ok)
    ========================= */

    match /automaten/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    match /Automatenbestand/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    match /Standorte/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    match /Kontakte/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    // optional legacy lowercase
    match /kontakte/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    match /Wartungselemente/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isPrivileged();
    }

    /* =========================
       Operative Daten
       (haben jetzt alle `stadt`)
    ========================= */

    match /wochenWartung/{id} {
      // ✅ FIX: PIN-Session darf lesen, sonst kann die Reiniger-App die Wochenwartung nicht "öffnen"
      allow read: if isPrivileged()
        || teamleiterCityRead()
        || teamleiterQueryRead()
        || hasPinSession();
      allow create, update: if hasPinSession() || isPrivileged();
      allow delete: if isPrivileged();
    }

    match /Wartungsprotokolle/{id} {
      allow read: if isPrivileged() || teamleiterCityRead() || teamleiterQueryRead();
      allow create: if hasPinSession() || isPrivileged();
      allow update, delete: if isPrivileged();
    }

    match /reinigungen/{id} {
      allow read: if isPrivileged() || teamleiterCityRead() || teamleiterQueryRead();
      allow create: if hasPinSession() || isPrivileged();
      allow update, delete: if isPrivileged();
    }

    match /bestellungen/{id} {
      allow read: if isPrivileged() || teamleiterCityRead() || teamleiterQueryRead() || hasPinSession();
      allow create: if hasPinSession() || isPrivileged();
      allow update, delete: if isPrivileged();
    }

    /* =========================
       Rowy (falls vorhanden)
    ========================= */

    match /_rowy_/{document=**} {
      allow read, write: if isPrivileged();
    }

    /* =========================
       Default: alles andere zu
    ========================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
